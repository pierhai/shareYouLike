---
import { readFileSync } from 'fs';
import { join } from 'path';

const linksPath = join(process.cwd(), '..', 'data', 'links.json');
const linksData = JSON.parse(readFileSync(linksPath, 'utf-8'));
const links = linksData.links || linksData;

// 将分类合并到标签中，生成所有标签列表
const allTags = [...new Set(links.flatMap(link => {
  let tags = link.tags || [];
  if (link.category) {
    tags = [...tags, link.category];
  }
  return tags;
}))].sort();

// 将每个链接的分类合并到标签中
links.forEach(link => {
  if (link.category && (!link.tags || !link.tags.includes(link.category))) {
    link.tags = [...(link.tags || []), link.category];
  }
});
---

<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Share You Like - GitHub 资源分享</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f5f5;
      color: #333;
    }
    .container {
      display: flex;
      min-height: 100vh;
    }
    .sidebar {
      width: 240px;
      background: #fff;
      border-right: 1px solid #e0e0e0;
      padding: 20px 0;
      position: fixed;
      height: 100vh;
      overflow-y: auto;
    }
    .sidebar h2 {
      font-size: 16px;
      font-weight: 600;
      padding: 0 20px 12px;
      color: #666;
      border-bottom: 1px solid #eee;
      margin-bottom: 10px;
    }
    .tag-list {
      list-style: none;
    }
    .tag-list li {
      padding: 8px 20px;
      cursor: pointer;
      font-size: 14px;
      transition: background 0.2s;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .tag-list li:hover {
      background: #f0f0f0;
    }
    .tag-list li.active {
      background: #e6f7ff;
      color: #1890ff;
      font-weight: 500;
    }
    .tag-count {
      font-size: 12px;
      color: #999;
      background: #f0f0f0;
      padding: 2px 8px;
      border-radius: 10px;
    }
    .main-content {
      flex: 1;
      margin-left: 240px;
      padding: 24px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }
    .header h1 {
      font-size: 24px;
      font-weight: 600;
    }
    .search-box {
      width: 300px;
      padding: 8px 12px;
      border: 1px solid #d9d9d9;
      border-radius: 6px;
      font-size: 14px;
      outline: none;
    }
    .search-box:focus {
      border-color: #1890ff;
      box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);
    }
    .links-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
      gap: 16px;
    }
    .link-card {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 16px;
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    .link-card:hover {
      box-shadow: 0 2px 8px rgba(0,0,0,0.12);
      border-color: #d0d0d0;
    }
    .link-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .link-title a {
      color: #1890ff;
      text-decoration: none;
    }
    .link-title a:hover {
      text-decoration: underline;
    }
    .link-desc {
      font-size: 13px;
      color: #666;
      margin-bottom: 12px;
      line-height: 1.5;
    }
    .link-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: #999;
    }
    .link-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 8px;
    }
    .link-tag {
      display: inline-block;
      padding: 2px 8px;
      background: #f0f7ff;
      color: #1890ff;
      border-radius: 3px;
      font-size: 12px;
      cursor: pointer;
      transition: background 0.2s;
    }
    .link-tag:hover {
      background: #d6e8ff;
    }
    .footer-info {
      margin-top: 24px;
      text-align: center;
      color: #999;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="container">
    <aside class="sidebar">
      <h2>标签分类</h2>
      <ul class="tag-list" id="tagList">
        <li class="active" data-tag="all">
          全部
        </li>
        {allTags.map(tag => (
          <li data-tag={tag}>
            {tag}
          </li>
        ))}
      </ul>
    </aside>

    <main class="main-content">
      <div class="header">
        <h1>Share You Like</h1>
        <input class="search-box" type="text" id="searchBox" placeholder="搜索链接..." />
      </div>

      <div class="links-grid" id="linksGrid">
        {links.map(link => (
          <div class="link-card" data-tags={(link.tags || []).join(',')} data-title={(link.title || '').toLowerCase()} data-desc={(link.description || '').toLowerCase()}>
            <div class="link-title">
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.title || link.url}
              </a>
            </div>
            {link.description && (
              <div class="link-desc">{link.description}</div>
            )}
            <div class="link-meta">
              {link.date && <span>📅 {link.date}</span>}
              {link.source && <span>🔗 {link.source}</span>}
            </div>
            {link.tags && link.tags.length > 0 && (
              <div class="link-tags">
                {link.tags.map(tag => (
                  <span class="link-tag" data-tag={tag}>{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="footer-info">
        共 {links.length} 个链接 · Share You Like
      </div>
    </main>
  </div>

  <script>
    const tagList = document.getElementById('tagList');
    const linksGrid = document.getElementById('linksGrid');
    const searchBox = document.getElementById('searchBox');
    let currentTag = 'all';
    let currentSearch = '';

    // 标签筛选
    tagList.addEventListener('click', (e) => {
      const li = e.target.closest('li');
      if (!li) return;

      document.querySelectorAll('.tag-list li').forEach(item => item.classList.remove('active'));
      li.classList.add('active');

      currentTag = li.dataset.tag;
      filterLinks();
    });

    // 标签点击筛选
    linksGrid.addEventListener('click', (e) => {
      if (e.target.classList.contains('link-tag')) {
        const tag = e.target.dataset.tag;
        const li = document.querySelector(`.tag-list li[data-tag="${tag}"]`);
        if (li) {
          document.querySelectorAll('.tag-list li').forEach(item => item.classList.remove('active'));
          li.classList.add('active');
          currentTag = tag;
          filterLinks();
        }
      }
    });

    // 搜索
    searchBox.addEventListener('input', (e) => {
      currentSearch = e.target.value.toLowerCase();
      filterLinks();
    });

    function filterLinks() {
      const cards = document.querySelectorAll('.link-card');
      cards.forEach(card => {
        const tags = card.dataset.tags || '';
        const title = card.dataset.title || '';
        const desc = card.dataset.desc || '';
        const tagMatch = currentTag === 'all' || tags.split(',').includes(currentTag);
        const searchMatch = !currentSearch || title.includes(currentSearch) || desc.includes(currentSearch);
        card.style.display = (tagMatch && searchMatch) ? '' : 'none';
      });
    }
  </script>
</body>
</html>